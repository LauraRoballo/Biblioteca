@* Plantilla común de las vistas MVC del administrador.
   Reproduce el diseño de AdminLayout.razor para que el módulo se vea igual al resto del panel. *@
<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>@ViewData["Title"] · Administrador</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="css/variables.css" />
    <link rel="stylesheet" href="css/layout.css" />
    <link rel="stylesheet" href="css/components.css" />
    <link rel="stylesheet" href="css/pages.css" />
    <link rel="stylesheet" href="css/panel.css" />
    <link rel="stylesheet" href="css/app.css" />
</head>

<body>
    <nav class="navbar navbarBiblioteca">
        <div class="container">
            <img src="img/Escudo.png" class="logoBiblioteca" alt="Escudo" />
            <span class="navbar-brand">Biblioteca Liceísta</span>
        </div>
    </nav>

    <div class="panel-layout rol-admin">
        <aside class="panel-sidebar">
            <div class="panel-sidebar-header">
                <i class="bi bi-shield-lock rol-icono"></i>
                <div>
                    <h5>Administrador</h5>
                    <small>Panel de gestión</small>
                </div>
            </div>
            <ul class="panel-sidebar-nav">
                <li><a href="admin/dashboard"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
                <li><a href="admin/usuarios"><i class="bi bi-people"></i> Gestión de Usuarios</a></li>
                <li><a href="libros" class="activo"><i class="bi bi-journal-bookmark"></i> Gestión de Libros</a></li>
                <li><a href="admin/prestamos"><i class="bi bi-arrow-left-right"></i> Préstamos</a></li>
                <li><a href="admin/devoluciones"><i class="bi bi-arrow-return-left"></i> Devoluciones</a></li>
                <li><a href="admin/reservas"><i class="bi bi-calendar-check"></i> Reservas</a></li>
                <li><a href="admin/reportes"><i class="bi bi-bar-chart-line"></i> Reportes y Estadísticas</a></li>
                <li><a href="admin/notificaciones"><i class="bi bi-bell"></i> Notificaciones</a></li>
                <li><a href="admin/configuracion"><i class="bi bi-gear"></i> Configuración</a></li>
                <li><a href="admin/perfil"><i class="bi bi-person-circle"></i> Perfil</a></li>
            </ul>
        </aside>

        <div class="panel-content">
            <div class="panel-topbar">
                <span class="rol-pill"><i class="bi bi-shield-lock"></i> Administrador</span>
                <div class="panel-topbar-acciones">
                    <span><i class="bi bi-person"></i> @User.Identity?.Name</span>
                    <a href="cerrar-sesion"><i class="bi bi-box-arrow-right"></i> Cerrar sesión</a>
                </div>
            </div>

            @if (TempData["Mensaje"] is string mensaje)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    @mensaje
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="alert alert-danger alert-dismissible fade show">
                    @error
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            }

            @RenderBody()
        </div>
    </div>

    <footer class="footerBiblioteca">
        <div class="container">
            <div class="row align-items-center gy-3">
                <div class="col-md-6 d-flex align-items-center">
                    <img src="img/Escudo.png" class="footerLogo" alt="Escudo" />
                    <div class="ms-3">
                        <h5 class="mb-0">Colegio Liceo Femenino</h5>
                        <p class="mb-0">Mercedes Nariño</p>
                    </div>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <small>&copy; @DateTime.Now.Year Biblioteca Liceísta</small>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
