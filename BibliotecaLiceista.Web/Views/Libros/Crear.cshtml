@model Libro
@{
    ViewData["Title"] = "Registrar libro";
}

<div class="panel-titulo">
    <h2><i class="bi bi-journal-bookmark"></i> Registrar libro</h2>
</div>

<div class="panel-card">
    @* Formulario con método POST: los datos viajan en el cuerpo de la petición, no en la URL *@
    <form method="post" action="libros/crear">
        @Html.AntiForgeryToken()

        @await Html.PartialAsync("_FormularioLibro", Model)

        <div class="mt-4">
            <button type="submit" class="btn botonPrincipal"><i class="bi bi-check-lg"></i> Guardar</button>
            <a href="libros" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>
