@model List<Libro>
@{
    ViewData["Title"] = "Gestión de Libros";
    var textoBusqueda = ViewData["Busqueda"] as string;
}

<div class="panel-titulo">
    <h2><i class="bi bi-journal-bookmark"></i> Gestión de Libros</h2>
    <a href="libros/crear" class="btn botonPrincipal"><i class="bi bi-plus-lg"></i> Registrar Libro</a>
</div>

<div class="panel-card">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <h5 class="mb-0">Catálogo (@Model.Count)</h5>

        @* Formulario con método GET: el texto viaja en la URL → /libros?busqueda=... *@
        <form method="get" action="libros" class="d-flex gap-2">
            <input type="search" name="busqueda" class="form-control panel-busqueda" style="margin-bottom:0;"
                   value="@textoBusqueda" placeholder="Buscar por título o ISBN..." />
            <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-search"></i> Buscar</button>
            @if (!string.IsNullOrWhiteSpace(textoBusqueda))
            {
                <a href="libros" class="btn btn-outline-secondary">Limpiar</a>
            }
        </form>
    </div>

    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Título</th>
                    <th>ISBN</th>
                    <th>Editorial</th>
                    <th>Categoría</th>
                    <th>Año</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var libro in Model)
                {
                    <tr>
                        <td>@libro.Titulo</td>
                        <td>@libro.ISBN</td>
                        <td>@libro.NombreEditorial</td>
                        <td>@libro.NombreCategoria</td>
                        <td>@libro.AnioPublicacion</td>
                        <td><span class="badge bg-secondary">@libro.NombreEstadoLibro</span></td>
                        <td class="text-end text-nowrap">
                            <a href="libros/editar/@libro.IDLibro" class="btn btn-sm btn-outline-secondary" title="Editar">
                                <i class="bi bi-pencil"></i>
                            </a>

                            @* Formulario con método POST: eliminar modifica datos, por eso no se hace con GET *@
                            <form method="post" action="libros/eliminar/@libro.IDLibro" class="d-inline"
                                  onsubmit="return confirm('¿Desea eliminar este libro?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }

                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted">
                            @(string.IsNullOrWhiteSpace(textoBusqueda)
                                ? "No hay libros registrados."
                                : $"No se encontraron libros para \"{textoBusqueda}\".")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
