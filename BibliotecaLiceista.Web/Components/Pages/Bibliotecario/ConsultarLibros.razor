@page "/bibliotecario/consultar-libros"
@layout BibliotecarioLayout

<PageTitle>Consultar Libros · Bibliotecario</PageTitle>

<div class="panel-titulo">
    <h2><i class="bi bi-journal-bookmark"></i> Consultar Libros</h2>
</div>

<div class="panel-card">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <h5 class="mb-0">Catálogo</h5>
        <input type="search" class="form-control panel-busqueda" style="margin-bottom:0;" placeholder="Buscar por título o autor..." />
    </div>
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Título</th>
                    <th>Autor</th>
                    <th>Categoría</th>
                    <th>Stock</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Cien años de soledad</td><td>Gabriel García Márquez</td><td>Literatura</td><td>4</td>
                    <td><span class="badge bg-success">Disponible</span></td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#modalDetalleLibro" title="Ver detalle"><i class="bi bi-eye"></i></button>
                    </td>
                </tr>
                <tr>
                    <td>El principito</td><td>Antoine de Saint-Exupéry</td><td>Infantil</td><td>0</td>
                    <td><span class="badge bg-danger">Prestado</span></td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#modalDetalleLibro" title="Ver detalle"><i class="bi bi-eye"></i></button>
                    </td>
                </tr>
                <tr>
                    <td>Física para bachillerato</td><td>Serway / Jewett</td><td>Ciencias</td><td>2</td>
                    <td><span class="badge bg-success">Disponible</span></td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#modalDetalleLibro" title="Ver detalle"><i class="bi bi-eye"></i></button>
                    </td>
                </tr>
                <tr>
                    <td>Cálculo diferencial</td><td>James Stewart</td><td>Matemáticas</td><td>6</td>
                    <td><span class="badge bg-success">Disponible</span></td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#modalDetalleLibro" title="Ver detalle"><i class="bi bi-eye"></i></button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Ver detalle del libro (visual, sin backend) -->
<div class="modal fade" id="modalDetalleLibro" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Detalle del libro</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p><strong>Título:</strong> Cien años de soledad</p>
                <p><strong>Autor:</strong> Gabriel García Márquez</p>
                <p><strong>Categoría:</strong> Literatura</p>
                <p><strong>ISBN:</strong> 978-84-397-2071-7</p>
                <p class="mb-0"><strong>Stock disponible:</strong> 4 de 5 ejemplares</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>
