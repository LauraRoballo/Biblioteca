@page "/bibliotecario/usuarios"
@layout BibliotecarioLayout

<PageTitle>Consultar Usuarios · Bibliotecario</PageTitle>

<div class="panel-titulo">
    <h2><i class="bi bi-people"></i> Consultar Usuarios</h2>
</div>

<div class="panel-card">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <h5 class="mb-0">Usuarios</h5>
        <input type="search" class="form-control panel-busqueda" style="margin-bottom:0;" placeholder="Buscar por nombre o correo..." />
    </div>
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Correo institucional</th>
                    <th>Tipo de usuario</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Laura Gómez</td><td>laura.gomez@@liceofemenino.edu.co</td><td>Alumno</td>
                    <td><span class="badge bg-success">Activo</span></td>
                    <td class="text-end"><button class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#modalDetalleUsuario" title="Ver detalle"><i class="bi bi-eye"></i></button></td>
                </tr>
                <tr>
                    <td>Carlos Ruiz</td><td>carlos.ruiz@@liceofemenino.edu.co</td><td>Docente</td>
                    <td><span class="badge bg-success">Activo</span></td>
                    <td class="text-end"><button class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#modalDetalleUsuario" title="Ver detalle"><i class="bi bi-eye"></i></button></td>
                </tr>
                <tr>
                    <td>Juan Pérez</td><td>juan.perez@@liceofemenino.edu.co</td><td>Alumno</td>
                    <td><span class="badge bg-secondary">Inactivo</span></td>
                    <td class="text-end"><button class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#modalDetalleUsuario" title="Ver detalle"><i class="bi bi-eye"></i></button></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Ver detalle del usuario (visual, sin backend) -->
<div class="modal fade" id="modalDetalleUsuario" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Detalle del usuario</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p><strong>Nombre:</strong> Laura Gómez</p>
                <p><strong>Correo:</strong> laura.gomez@@liceofemenino.edu.co</p>
                <p><strong>Tipo de usuario:</strong> Alumno</p>
                <p class="mb-0"><strong>Préstamos activos:</strong> 1</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>
