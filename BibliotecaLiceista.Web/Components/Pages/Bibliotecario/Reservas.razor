                        <button class="btn btn-sm btn-outline-danger" title="Rechazar"><i class="bi bi-x-lg"></i></button>
                    </td>
                </tr>
                <tr>
                    <td>Juan Pérez</td><td>Historia de Colombia</td><td>23/08/2026</td>
