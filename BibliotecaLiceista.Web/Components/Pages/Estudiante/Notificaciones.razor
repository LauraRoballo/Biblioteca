@page "/estudiante/notificaciones"
@layout EstudianteLayout

<PageTitle>Notificaciones · Estudiante</PageTitle>

<div class="panel-titulo">
    <h2><i class="bi bi-bell"></i> Notificaciones</h2>
</div>

<div class="panel-card">
    <ul class="lista-notificaciones">
        <li>
            <div class="noti-icono"><i class="bi bi-clock-history"></i></div>
            <div class="noti-texto">
                <p>"El principito" vence en 1 día. No olvides devolverlo o renovarlo.</p>
                <small>Hace 2 horas</small>
            </div>
        </li>
        <li>
            <div class="noti-icono"><i class="bi bi-journal-bookmark"></i></div>
            <div class="noti-texto">
                <p>El libro que reservaste, "Física para bachillerato", ya está disponible.</p>
                <small>Ayer</small>
            </div>
        </li>
        <li>
            <div class="noti-icono"><i class="bi bi-info-circle"></i></div>
            <div class="noti-texto">
                <p>Recordatorio: podés renovar un préstamo una sola vez si nadie lo reservó.</p>
                <small>20/08/2026</small>
            </div>
        </li>
    </ul>
</div>
