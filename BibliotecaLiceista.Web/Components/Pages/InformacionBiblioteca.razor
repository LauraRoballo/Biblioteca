@page "/informacion-biblioteca"

<PageTitle>Información de la biblioteca</PageTitle>

<div class="container my-5">
    <div class="card shadow cardAuth">
        <div class="card-body">

            <h2 class="text-center mb-4">Información de la Biblioteca</h2>
            <p class="textoAuth text-center mb-5">
                Todo lo que necesitás saber antes de acercarte o registrarte.
            </p>

            <div class="row g-4">

                <div class="col-md-6">
                    <h5><i class="bi bi-clock text-warning"></i> Horario de atención</h5>
                    <p class="textoAuth mb-0" style="text-align:left;">
                        Lunes a viernes: 7:00 a. m. – 4:00 p. m.<br />
                        Sábados: 8:00 a. m. – 12:00 m.
                    </p>
                </div>

                <div class="col-md-6">
                    <h5><i class="bi bi-geo-alt text-warning"></i> Ubicación</h5>
                    <p class="textoAuth mb-0" style="text-align:left;">
                        Colegio Liceo Femenino Mercedes Nariño<br />
                        Av. Caracas, Bogotá D.C.
                    </p>
                </div>

                <div class="col-md-6">
                    <h5><i class="bi bi-journal-bookmark text-warning"></i> Préstamos</h5>
                    <p class="textoAuth mb-0" style="text-align:left;">
                        Hasta 2 libros por alumno, por un máximo de 8 días
                        calendario, renovables una vez si nadie los tiene
                        reservados.
                    </p>
                </div>

                <div class="col-md-6">
                    <h5><i class="bi bi-envelope text-warning"></i> Contacto</h5>
                    <p class="textoAuth mb-0" style="text-align:left;">
                        biblioteca@@liceofemenino.edu.co<br />
                        Ext. 105
                    </p>
                </div>

            </div>

            <a href="login" class="linkBiblioteca">
                Volver a iniciar sesión
            </a>

        </div>
    </div>
</div>
