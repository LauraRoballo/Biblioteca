@page "/registro"
@attribute [Authorize(Roles = RolesUsuario.Administrador)]

@* RF-001: solo el administrador crea cuentas; no hay registro público. *@
@inject UsuarioRepository UsuarioRepository
@inject NavigationManager Navegacion

<PageTitle>Crear usuario</PageTitle>

<div class="login-page">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">

                <EditForm Model="nuevoUsuario" OnValidSubmit="RegistrarAsync" class="formRegistro">
                    <div class="card cardRegistro shadow">
                        <div class="card-body">

                            <img src="img/usuario.png" class="iconoPagina" alt="Usuario" />

                            <h2 class="text-center mb-4">Crear usuario</h2>

                            <div class="row g-3">

                                <!-- Nombre -->
                                <div class="col-md-6">
                                    <label for="nombre" class="form-label">Nombre</label>
                                    <InputText class="form-control" id="nombre" @bind-Value="nuevoUsuario.Nombre" placeholder="Ingrese su nombre" required />
                                </div>

                                <!-- Apellido -->
                                <div class="col-md-6">
                                    <label for="apellido" class="form-label">Apellido</label>
                                    <InputText class="form-control" id="apellido" @bind-Value="nuevoUsuario.Apellido" placeholder="Ingrese su apellido" required />
                                </div>

                                <!-- Teléfono -->
                                <div class="col-md-6">
                                    <label for="telefono" class="form-label">Teléfono</label>
                                    <InputText class="form-control" id="telefono" @bind-Value="nuevoUsuario.Telefono" placeholder="Ingrese su teléfono" />
                                </div>

                                <!-- Tipo -->
                                <div class="col-md-6">
                                    <label for="tipoUsuario" class="form-label">Tipo de usuario</label>
                                    <InputSelect class="form-select" id="tipoUsuario" @bind-Value="nuevoUsuario.IDTipoUsuario">
                                        <option value="0">Seleccione...</option>
                                        @foreach (var tipoUsuario in listaTiposUsuario)
                                        {
                                            <option value="@tipoUsuario.IDTipoUsuario">@tipoUsuario.NombreTipo</option>
                                        }
                                    </InputSelect>
                                </div>

                                <!-- Correo -->
                                <div class="col-md-6">
                                    <label for="correoInstitucional" class="form-label">Correo institucional</label>
                                    <InputText class="form-control" type="email" id="correoInstitucional" @bind-Value="nuevoUsuario.Correo" placeholder="Ingrese el correo institucional" required />
                                </div>

                                <!-- Contraseña -->
                                <div class="col-md-6">
                                    <label for="contrasenia" class="form-label">Contraseña</label>
                                    <InputText class="form-control" type="password" id="contrasenia" @bind-Value="nuevoUsuario.Contrasenia" placeholder="Ingrese una contraseña" required />
                                </div>

                            </div>

                            @if (!string.IsNullOrEmpty(mensajeError))
                            {
                                <div class="alert alert-danger mt-3">@mensajeError</div>
                            }

                            <div class="text-center mt-4">
                                <button class="btn botonPrincipal" type="submit">
                                    Crear usuario
                                </button>
                            </div>

                            <a href="admin/usuarios" class="linkBiblioteca">
                                Volver a Gestión de Usuarios
                            </a>

                        </div>
                    </div>
                </EditForm>

            </div>
        </div>
    </div>
</div>

@code {
    private Usuario nuevoUsuario = new();
    private List<TipoUsuario> listaTiposUsuario = new();
    private string? mensajeError;

    protected override async Task OnInitializedAsync()
    {
        listaTiposUsuario = await UsuarioRepository.ConsultarTiposUsuarioAsync();
    }

    private async Task RegistrarAsync()
    {
        mensajeError = null;

        if (nuevoUsuario.IDTipoUsuario == 0)
        {
            mensajeError = "Seleccione el tipo de usuario.";
            return;
        }

        if (await UsuarioRepository.ConsultarPorCorreoAsync(nuevoUsuario.Correo) is not null)
        {
            mensajeError = "Ya existe un usuario registrado con ese correo.";
            return;
        }

        await UsuarioRepository.InsertarAsync(nuevoUsuario);
        Navegacion.NavigateTo("admin/usuarios");
    }
}
