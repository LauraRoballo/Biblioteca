@page "/admin/perfil"
@layout AdminLayout

<PageTitle>Perfil · Administrador</PageTitle>

<div class="panel-titulo">
    <h2><i class="bi bi-person-circle"></i> Perfil</h2>
</div>

<div class="panel-card">
    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label">Nombre</label>
            <input type="text" class="form-control" value="Ana" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Apellido</label>
            <input type="text" class="form-control" value="Ramírez" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Correo institucional</label>
            <input type="email" class="form-control" value="ana.ramirez@@liceofemenino.edu.co" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Documento</label>
            <input type="text" class="form-control" value="1.020.345.678" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Teléfono</label>
            <input type="text" class="form-control" value="601 555 0123" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Tipo de usuario</label>
            <input type="text" class="form-control" value="Administrador" disabled />
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2 mt-3">
        <button type="button" class="btn botonPrincipal">Guardar cambios</button>
        <a href="cambiar-contrasenia" class="btn btn-outline-secondary">Cambiar contraseña</a>
        <a href="login" class="btn btn-outline-danger">Cerrar sesión</a>
    </div>
</div>
