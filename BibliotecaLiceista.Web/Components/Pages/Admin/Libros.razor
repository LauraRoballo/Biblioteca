@page "/admin/libros"
@layout AdminLayout

<PageTitle>Gestión de Libros · Administrador</PageTitle>

<div class="panel-titulo">
    <h2><i class="bi bi-journal-bookmark"></i> Gestión de Libros</h2>
    <div>
        <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#modalCategorias">
            <i class="bi bi-tags"></i> Gestionar Categorías
        </button>
        <button type="button" class="btn botonPrincipal" data-bs-toggle="modal" data-bs-target="#modalRegistrarLibro">
            <i class="bi bi-plus-lg"></i> Registrar Libro
        </button>
    </div>
</div>

<div class="panel-card">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <h5 class="mb-0">Catálogo</h5>
        <input type="search" class="form-control panel-busqueda" style="margin-bottom:0;" placeholder="Buscar por título o autor..." />
    </div>
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Título</th>
                    <th>Autor</th>
                    <th>Categoría</th>
                    <th>Stock</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Cien años de soledad</td>
                    <td>Gabriel García Márquez</td>
                    <td>Literatura</td>
                    <td>4</td>
                    <td><span class="badge bg-success">Disponible</span></td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-secondary" title="Editar"><i class="bi bi-pencil"></i></button>
                        <button class="btn btn-sm btn-outline-danger" title="Eliminar"><i class="bi bi-trash"></i></button>
                    </td>
                </tr>
                <tr>
                    <td>El principito</td>
                    <td>Antoine de Saint-Exupéry</td>
                    <td>Infantil</td>
                    <td>0</td>
                    <td><span class="badge bg-danger">Prestado</span></td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-secondary" title="Editar"><i class="bi bi-pencil"></i></button>
                        <button class="btn btn-sm btn-outline-danger" title="Eliminar"><i class="bi bi-trash"></i></button>
                    </td>
                </tr>
                <tr>
                    <td>Física para bachillerato</td>
                    <td>Serway / Jewett</td>
                    <td>Ciencias</td>
                    <td>2</td>
                    <td><span class="badge bg-success">Disponible</span></td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-secondary" title="Editar"><i class="bi bi-pencil"></i></button>
                        <button class="btn btn-sm btn-outline-danger" title="Eliminar"><i class="bi bi-trash"></i></button>
                    </td>
                </tr>
                <tr>
                    <td>Historia de Colombia</td>
                    <td>Jorge Orlando Melo</td>
                    <td>Historia</td>
                    <td>0</td>
                    <td><span class="badge bg-warning text-dark">Agotado</span></td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-secondary" title="Editar"><i class="bi bi-pencil"></i></button>
                        <button class="btn btn-sm btn-outline-danger" title="Eliminar"><i class="bi bi-trash"></i></button>
                    </td>
                </tr>
                <tr>
                    <td>Cálculo diferencial</td>
                    <td>James Stewart</td>
                    <td>Matemáticas</td>
                    <td>6</td>
                    <td><span class="badge bg-success">Disponible</span></td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-secondary" title="Editar"><i class="bi bi-pencil"></i></button>
                        <button class="btn btn-sm btn-outline-danger" title="Eliminar"><i class="bi bi-trash"></i></button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Registrar Libro (visual, sin backend) -->
<div class="modal fade" id="modalRegistrarLibro" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Registrar libro</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <label class="form-label">Título</label>
                <input type="text" class="form-control" placeholder="Título del libro" required />

                <label class="form-label">Autor</label>
                <input type="text" class="form-control" placeholder="Autor" required />

                <label class="form-label">ISBN</label>
                <input type="text" class="form-control" placeholder="Código ISBN" />

                <label class="form-label">Categoría</label>
                <select class="form-select mb-3">
                    <option>Literatura</option>
                    <option>Ciencias</option>
                    <option>Historia</option>
                    <option>Matemáticas</option>
                    <option>Infantil</option>
                </select>

                <label class="form-label">Stock</label>
                <input type="number" class="form-control" min="0" value="1" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn botonPrincipal">Guardar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Gestionar Categorías (visual, sin backend) -->
<div class="modal fade" id="modalCategorias" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Gestionar categorías</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <ul class="list-group mb-3">
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        Literatura
                        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        Ciencias
                        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        Historia
                        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        Matemáticas
                        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                    </li>
                </ul>
                <label class="form-label">Nueva categoría</label>
                <input type="text" class="form-control" placeholder="Nombre de la categoría" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn botonPrincipal">Agregar</button>
            </div>
        </div>
    </div>
</div>
