@page "/admin/notificaciones"
@layout AdminLayout

<PageTitle>Notificaciones · Administrador</PageTitle>

<div class="panel-titulo">
    <h2><i class="bi bi-bell"></i> Notificaciones</h2>
</div>

<div class="panel-card">
    <ul class="lista-notificaciones">
        <li>
            <div class="noti-icono"><i class="bi bi-exclamation-circle"></i></div>
            <div class="noti-texto">
                <p>9 préstamos están vencidos y requieren seguimiento.</p>
                <small>Hace 2 horas</small>
            </div>
        </li>
        <li>
            <div class="noti-icono"><i class="bi bi-calendar-check"></i></div>
            <div class="noti-texto">
                <p>Hay 14 reservas pendientes de aprobación.</p>
                <small>Hace 5 horas</small>
            </div>
        </li>
        <li>
            <div class="noti-icono"><i class="bi bi-person-plus"></i></div>
            <div class="noti-texto">
                <p>Se registraron 3 nuevos usuarios hoy.</p>
                <small>Hoy, 9:40 a. m.</small>
            </div>
        </li>
        <li>
            <div class="noti-icono"><i class="bi bi-clock-history"></i></div>
            <div class="noti-texto">
                <p>Recordatorio: 5 libros vencen en los próximos 2 días.</p>
                <small>Ayer</small>
            </div>
        </li>
        <li>
            <div class="noti-icono"><i class="bi bi-shield-check"></i></div>
            <div class="noti-texto">
                <p>La copia de seguridad automática se completó correctamente.</p>
                <small>24/08/2026</small>
            </div>
        </li>
    </ul>
</div>
