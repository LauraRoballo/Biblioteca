@page "/admin/usuarios"
@layout AdminLayout
@using Microsoft.Data.SqlClient
@inject UsuarioRepository UsuarioRepository

<PageTitle>Gestión de Usuarios · Administrador</PageTitle>

<div class="panel-titulo">
    <h2><i class="bi bi-people"></i> Gestión de Usuarios</h2>
    <a href="registro" class="btn botonPrincipal"><i class="bi bi-person-plus"></i> Registrar Usuario</a>
</div>

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="alert alert-info">@mensaje</div>
}

@if (usuarioEditando is not null)
{
    <div class="panel-card mb-3">
        <h5>Editar usuario</h5>
        <EditForm Model="usuarioEditando" OnValidSubmit="GuardarCambiosAsync">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Nombre</label>
                    <InputText class="form-control" @bind-Value="usuarioEditando.Nombre" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Apellido</label>
                    <InputText class="form-control" @bind-Value="usuarioEditando.Apellido" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Correo institucional</label>
                    <InputText class="form-control" type="email" @bind-Value="usuarioEditando.Correo" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Teléfono</label>
                    <InputText class="form-control" @bind-Value="usuarioEditando.Telefono" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Tipo de usuario</label>
                    <InputSelect class="form-select" @bind-Value="usuarioEditando.IDTipoUsuario">
                        @foreach (var tipoUsuario in listaTiposUsuario)
                        {
                            <option value="@tipoUsuario.IDTipoUsuario">@tipoUsuario.NombreTipo</option>
                        }
                    </InputSelect>
                </div>
            </div>
            <div class="mt-3">
                <button type="submit" class="btn botonPrincipal">Guardar cambios</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="CancelarEdicion">Cancelar</button>
            </div>
        </EditForm>
    </div>
}

<div class="panel-card">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <h5 class="mb-0">Usuarios registrados</h5>
        <input type="search" class="form-control panel-busqueda" style="margin-bottom:0;"
               placeholder="Buscar por nombre o correo..." @bind="textoBusqueda" @bind:event="oninput" />
    </div>
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Correo institucional</th>
                    <th>Teléfono</th>
                    <th>Tipo de usuario</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var usuario in UsuariosFiltrados)
                {
                    <tr>
                        <td>@usuario.Nombre @usuario.Apellido</td>
                        <td>@usuario.Correo</td>
                        <td>@usuario.Telefono</td>
                        <td>@usuario.NombreTipoUsuario</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-secondary" title="Editar" @onclick="() => Editar(usuario)">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-danger" title="Eliminar" @onclick="() => EliminarAsync(usuario.IDUsuario)">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
                @if (!UsuariosFiltrados.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted">No hay usuarios para mostrar.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<Usuario> listaUsuarios = new();
    private List<TipoUsuario> listaTiposUsuario = new();
    private Usuario? usuarioEditando;
    private string? mensaje;
    private string textoBusqueda = string.Empty;

    private IEnumerable<Usuario> UsuariosFiltrados =>
        string.IsNullOrWhiteSpace(textoBusqueda)
            ? listaUsuarios
            : listaUsuarios.Where(usuario =>
                $"{usuario.Nombre} {usuario.Apellido}".Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase)
                || usuario.Correo.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        listaTiposUsuario = await UsuarioRepository.ConsultarTiposUsuarioAsync();
        await CargarUsuariosAsync();
    }

    private async Task CargarUsuariosAsync()
    {
        listaUsuarios = await UsuarioRepository.ConsultarTodosAsync();
    }

    private void Editar(Usuario usuario)
    {
        // Copia del usuario, para no modificar la fila de la tabla hasta guardar
        usuarioEditando = new Usuario
        {
            IDUsuario = usuario.IDUsuario,
            Nombre = usuario.Nombre,
            Apellido = usuario.Apellido,
            Correo = usuario.Correo,
            Telefono = usuario.Telefono,
            IDTipoUsuario = usuario.IDTipoUsuario
        };
        mensaje = null;
    }

    private void CancelarEdicion()
    {
        usuarioEditando = null;
    }

    private async Task GuardarCambiosAsync()
    {
        await UsuarioRepository.ActualizarAsync(usuarioEditando!);
        usuarioEditando = null;
        mensaje = "Usuario actualizado correctamente.";
        await CargarUsuariosAsync();
    }

    private async Task EliminarAsync(int idUsuario)
    {
        try
        {
            await UsuarioRepository.EliminarAsync(idUsuario);
            mensaje = "Usuario eliminado correctamente.";
            await CargarUsuariosAsync();
        }
        catch (SqlException error) when (error.Number == 547)   // 547 = violación de llave foránea
        {
            mensaje = "No se puede eliminar: el usuario tiene préstamos, reservas o notificaciones registradas.";
        }
    }
}
