@page "/admin/usuarios"
@layout AdminLayout

<PageTitle>Gestión de Usuarios · Administrador</PageTitle>

<div class="panel-titulo">
    <h2><i class="bi bi-people"></i> Gestión de Usuarios</h2>
    <a href="registro" class="btn botonPrincipal"><i class="bi bi-person-plus"></i> Registrar Usuario</a>
</div>

<div class="panel-card">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <h5 class="mb-0">Usuarios registrados</h5>
        <input type="search" class="form-control panel-busqueda" style="margin-bottom:0;" placeholder="Buscar por nombre o correo..." />
    </div>
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Correo institucional</th>
                    <th>Tipo de usuario</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Laura Gómez</td>
                    <td>laura.gomez@@liceofemenino.edu.co</td>
                    <td>Alumno</td>
                    <td><span class="badge bg-success">Activo</span></td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-secondary" title="Editar"><i class="bi bi-pencil"></i></button>
                        <button class="btn btn-sm btn-outline-secondary" title="Activar / Desactivar"><i class="bi bi-toggle-on"></i></button>
                        <button class="btn btn-sm btn-outline-secondary" title="Asignar roles"><i class="bi bi-person-gear"></i></button>
                    </td>
                </tr>
                <tr>
                    <td>Carlos Ruiz</td>
                    <td>carlos.ruiz@@liceofemenino.edu.co</td>
                    <td>Docente</td>
                    <td><span class="badge bg-success">Activo</span></td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-secondary" title="Editar"><i class="bi bi-pencil"></i></button>
                        <button class="btn btn-sm btn-outline-secondary" title="Activar / Desactivar"><i class="bi bi-toggle-on"></i></button>
                        <button class="btn btn-sm btn-outline-secondary" title="Asignar roles"><i class="bi bi-person-gear"></i></button>
                    </td>
                </tr>
                <tr>
                    <td>María Torres</td>
                    <td>maria.torres@@liceofemenino.edu.co</td>
                    <td>Bibliotecario</td>
                    <td><span class="badge bg-success">Activo</span></td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-secondary" title="Editar"><i class="bi bi-pencil"></i></button>
                        <button class="btn btn-sm btn-outline-secondary" title="Activar / Desactivar"><i class="bi bi-toggle-on"></i></button>
                        <button class="btn btn-sm btn-outline-secondary" title="Asignar roles"><i class="bi bi-person-gear"></i></button>
                    </td>
                </tr>
                <tr>
                    <td>Juan Pérez</td>
                    <td>juan.perez@@liceofemenino.edu.co</td>
                    <td>Alumno</td>
                    <td><span class="badge bg-secondary">Inactivo</span></td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-secondary" title="Editar"><i class="bi bi-pencil"></i></button>
                        <button class="btn btn-sm btn-outline-secondary" title="Activar / Desactivar"><i class="bi bi-toggle-off"></i></button>
                        <button class="btn btn-sm btn-outline-secondary" title="Asignar roles"><i class="bi bi-person-gear"></i></button>
                    </td>
                </tr>
                <tr>
                    <td>Ana Ramírez</td>
