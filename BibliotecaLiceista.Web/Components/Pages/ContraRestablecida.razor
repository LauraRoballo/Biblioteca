@page "/contrasena-restablecida"

<PageTitle>Contraseña restablecida</PageTitle>

<div class="container my-5">

    <!-- Imagen -->
    <div class="text-center">
        <img src="img/candado-confirmar.png" class="iconoAuth" alt="Contraseña restablecida" />
    </div>

    <!-- Alerta -->
    <div class="alertaBiblioteca alertaExito" id="alertaConfirmacion">

        <div class="alertaIcono">
            <img src="img/boton-de-verificacion.png" alt="Correcto" />
        </div>

        <div class="alertaMensaje">
            <h4>Contraseña restablecida</h4>
            <p>
                Se ha cambiado la contraseña correctamente.
                Inicie sesión nuevamente.
            </p>
        </div>

        <a class="btn botonPrincipal" href="login">
            Iniciar sesión
        </a>

    </div>

</div>
